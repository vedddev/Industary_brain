# Required for document ingestion. It creates the vector embeddings.
GOOGLE_API_KEY=your_google_ai_studio_key

# Two PostgreSQL databases. `industrial_knowledge` must run with pgvector.
DOCUMENTS_DATABASE_URL=postgresql+psycopg://industrial_app:industrial_app@localhost:5432/industrial_documents
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://industrial_app:industrial_app@localhost:5432/industrial_knowledge
EMBEDDING_DIMENSIONS=768

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://industary-brain.vercel.app

# Optional request limits.
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_UPLOAD=10
MAX_QUESTION_LENGTH=4000
